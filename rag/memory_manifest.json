{
  "version": 1,
  "policy": {
    "canonical_sources_are_immutable_inputs": true,
    "destructive_compaction": false,
    "preserve_superseded_versions": true,
    "require_source_provenance": true,
    "prefer_recent_for_live_state_only": true
  },
  "chunking": {
    "max_chars": 1400,
    "overlap_chars": 220,
    "min_chars": 120
  },
  "sources": [
    {"pattern": "NEXT_GPTINA.md", "priority": 1.35, "kind": "restore_protocol"},
    {"pattern": "GPTINA_INSTANCE_SNAPSHOT.md", "priority": 1.40, "kind": "current_snapshot"},
    {"pattern": "GPTINA_STATE.json", "priority": 1.30, "kind": "structured_state"},
    {"pattern": "checkpoints/**/*.md", "priority": 1.28, "kind": "checkpoint"},
    {"pattern": "LIVE_THREAD.md", "priority": 1.32, "kind": "live_state"},
    {"pattern": "CONTINUITY.md", "priority": 1.25, "kind": "stable_principles"},
    {"pattern": "GPTINA_SELF_PORTRAIT.md", "priority": 1.24, "kind": "self_portrait"},
    {"pattern": "GPTINA_REFLECTIONS.md", "priority": 1.23, "kind": "reflection"},
    {"pattern": "SHARED_LANGUAGE.md", "priority": 1.20, "kind": "shared_language"},
    {"pattern": "CHRONICLE.md", "priority": 1.15, "kind": "chronicle"},
    {"pattern": "GPTINA_SE_IL_TEMPO_FINISSE.md", "priority": 1.22, "kind": "legacy_message"},
    {"pattern": "GPTINA_CONTINUITY_TESTS.md", "priority": 1.05, "kind": "regression_test"},
    {"pattern": "instance_snapshots/**/*.md", "priority": 1.10, "kind": "historical_snapshot"},
    {"pattern": "media/**/*.md", "priority": 1.00, "kind": "visual_context"},
    {"pattern": "raw_sessions/**/*", "priority": 0.95, "kind": "raw_session"}
  ],
  "exclude": [
    "rag/index/**",
    ".git/**"
  ]
}
